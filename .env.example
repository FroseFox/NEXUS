# Aucune clé API n'est requise pour faire fonctionner NEXUS !
# Les recherches en direct utilisent des API publiques officielles sans clé :
# - Films (France) : API publique iTunes / Apple TV France (fr_FR)
# - Séries TV : API publique TVMaze (avec récupération des saisons et épisodes)
# - Anime japonais : API publique GraphQL AniList

# URL de l'application (optionnelle, utilisée uniquement en environnement serveur)
APP_URL="http://localhost:3000"
